# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Notificações push: gere com `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com

# Supabase → Project Settings → API Keys → Secret key (só no servidor, nunca NEXT_PUBLIC)
SUPABASE_SECRET_KEY=

# Senha aleatória que protege a rota do lembrete diário (cron da Vercel)
CRON_SECRET=

# Busca de lugares (Google Places API New). Opcional: sem ela, usa OpenStreetMap.
GOOGLE_PLACES_API_KEY=
